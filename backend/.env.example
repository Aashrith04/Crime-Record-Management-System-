PROJECT_NAME="Crime Record Management System (CRMS)"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL / SQLite fallback)
DATABASE_URL="sqlite:///./crms_dev.db"
# Example PostgreSQL URL: postgresql://postgres:postgres@localhost:5432/crms_db

# Security & JWT Secrets
SECRET_KEY="crms_enterprise_super_secret_jwt_key_change_in_production_min_32_bytes"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
